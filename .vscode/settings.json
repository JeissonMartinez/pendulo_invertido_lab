n'\\] for r in run\\)\n        \n        # First and last pos_ir\n        pos_start = float\\(run\\[0\\]\\['Pos_IR_cm'\\]\\)\n        pos_end = float\\(run\\[-1\\]\\['Pos_IR_cm'\\]\\)\n        \n        # Compute inter-sample gaps\n        gaps = \\[\\]\n        for j in range\\(1, len\\(run\\)\\):\n            t0 = parse_ts\\(run\\[j-1\\]\\['Timestamp'\\]\\)\n            t1 = parse_ts\\(run\\[j\\]\\['Timestamp'\\]\\)\n            gaps\\.append\\(\\(t1-t0\\)\\.total_seconds\\(\\)\\*1000\\)\n        \n        avg_gap = sum\\(gaps\\)/len\\(gaps\\) if gaps else 0\n        max_gap = max\\(gaps\\) if gaps else 0\n        min_gap = min\\(gaps\\) if gaps else 0\n        \n        # Count gaps > 200ms\n        big_gaps = \\[g for g in gaps if g > 200\\]\n        \n        print\\(f'  Run \\{i\\+1\\}: \\{len\\(run\\)\\} samples, \\{dur:\\.1f\\}s, dir=\\{dirs_in_run\\}'\\)\n        print\\(f'    pos: \\{pos_start:\\.1f\\} → \\{pos_end:\\.1f\\} cm'\\)\n        print\\(f'    gaps: avg=\\{avg_gap:\\.0f\\}ms, min=\\{min_gap:\\.0f\\}ms, max=\\{max_gap:\\.0f\\}ms'\\)\n        print\\(f'    gaps>200ms: \\{len\\(big_gaps\\)\\}'\\)\n        if big_gaps:\n            print\\(f'    big gaps: \\{\\[f\\\\\"\\{g:\\.0f\\}ms\\\\\" for g in sorted\\(big_gaps, reverse=True\\)\\[:5\\]\\]\\}'\\)\n\"\n$/": {
